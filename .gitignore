# Secrets + runtime state: never commit.
config/ai_providers.json
config/app_settings.json
config/admin_config.json
# Node registry: holds the key_hash of every node, so it is a secret.
config/nodes.json
# Armed kill targets (server/kill_switch.py). Runtime operator state, and a
# commit of it would ship an armed switch to every deploy.
config/kill_targets.json
# Persistent server state (lyrics, candidates, translations, token pool,
# renames). Renamed from cache/ -- see server/paths.py.
database/
# Pre-rename location, kept only so the one-shot migration in paths.py can
# find it on a deploy that still has the old directory. Remove once migrated.
cache/
logs/
tmp/
*.tar.gz
session-*.md
# Local AI context packs: generated, never pushed.
/log_pack.py
/pack.json
/client_edits_pack.py
# Python
__pycache__/
.venv/
